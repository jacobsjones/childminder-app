# Resend API Configuration
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Email address to send invoices from (must be verified in Resend)
RESEND_FROM_EMAIL=invoices@yourdomain.com

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Better Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# http://localhost:3000 locally, https://childminder-app.vercel.app in production
BETTER_AUTH_URL=

# Protects POST /api/init-db (send as the x-admin-secret header)
ADMIN_SECRET=

# Sign in with Apple (see AUTH_SETUP.md). Leave empty to hide the Apple button.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_APP_BUNDLE_IDENTIFIER=com.jacobjones.littlehours
